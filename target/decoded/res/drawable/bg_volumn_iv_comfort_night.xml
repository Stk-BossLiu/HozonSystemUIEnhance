<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false" android:state_pressed="true">
        <shape>
            <solid android:color="@color/bg_qs_rb_button_pressed_bg_comfort_night" />
            <corners android:radius="@dimen/volumn_iv_radius" />
        </shape>
    </item>
    <item android:state_selected="true" android:state_pressed="false">
        <shape>
            <solid android:color="@color/bg_qs_rb_button_selected_bg_comfort_night" />
            <corners android:radius="@dimen/volumn_iv_radius" />
        </shape>
    </item>
    <item android:state_selected="true" android:state_pressed="true">
        <shape>
            <solid android:color="@color/bg_qs_rb_button_pressed_selected_bg_comfort_night" />
            <corners android:radius="@dimen/volumn_iv_radius" />
        </shape>
    </item>
</selector>
