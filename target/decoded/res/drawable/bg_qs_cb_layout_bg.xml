<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false" android:state_pressed="false">
        <layer-list>
            <item android:drawable="@drawable/icon_bg_normal_ep32" />
        </layer-list>
    </item>
    <item android:state_selected="false" android:state_pressed="true">
        <layer-list>
            <item android:drawable="@drawable/icon_bg_pressed_ep32" />
        </layer-list>
    </item>
    <item android:state_selected="true" android:state_pressed="false">
        <layer-list>
            <item android:drawable="@drawable/icon_bg_selected_ep32" />
        </layer-list>
    </item>
    <item android:state_selected="true" android:state_pressed="true">
        <layer-list>
            <item android:drawable="@drawable/icon_bg_selected_pressed_ep32" />
        </layer-list>
    </item>
</selector>
