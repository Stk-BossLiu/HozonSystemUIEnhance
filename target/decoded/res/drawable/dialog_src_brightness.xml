<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false" android:state_pressed="false">
        <layer-list>
            <item android:drawable="@mipmap/dialog_icon_brightness_auto_normal" />
        </layer-list>
    </item>
    <item android:state_selected="false" android:state_pressed="true">
        <layer-list>
            <item android:drawable="@mipmap/dialog_icon_brightness_auto_normal_pressed" />
        </layer-list>
    </item>
    <item android:state_selected="true" android:state_pressed="false">
        <layer-list>
            <item android:drawable="@mipmap/dialog_icon_brightness_auto_selected" />
        </layer-list>
    </item>
    <item android:state_selected="true" android:state_pressed="true">
        <layer-list>
            <item android:drawable="@mipmap/dialog_icon_brightness_auto_selected_pressed" />
        </layer-list>
    </item>
</selector>
