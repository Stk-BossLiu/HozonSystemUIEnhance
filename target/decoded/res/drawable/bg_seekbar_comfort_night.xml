<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/vol_seekbar_bg_color_comfort_night" />
            <corners android:radius="@dimen/vol_seekbar_bg_corner" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient android:startColor="@color/volume_auto_off_on_color_ep40" android:endColor="@color/volume_auto_off_on_color_ep40" android:angle="270.0" />
                <corners android:radius="@dimen/vol_seekbar_bg_corner" />
            </shape>
        </clip>
    </item>
</layer-list>
