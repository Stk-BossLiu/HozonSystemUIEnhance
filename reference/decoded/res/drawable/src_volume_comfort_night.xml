<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false" android:state_pressed="false">
        <layer-list>
            <item android:drawable="@mipmap/svg_icon_volume_normal_comfort_night" />
        </layer-list>
    </item>
    <item android:state_selected="false" android:state_pressed="true">
        <layer-list>
            <item android:drawable="@mipmap/svg_icon_volume_pressed_comfort_night" />
        </layer-list>
    </item>
    <item android:state_selected="true" android:state_pressed="false">
        <layer-list>
            <item android:drawable="@mipmap/icon_volume_selected" />
        </layer-list>
    </item>
    <item android:state_selected="true" android:state_pressed="true">
        <layer-list>
            <item android:drawable="@mipmap/icon_volume_pressed_comfort_night" />
        </layer-list>
    </item>
</selector>
