<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="false">
        <shape>
            <solid android:color="@color/switch_unchecked_color" />
            <corners android:radius="99.0dip" />
            <stroke android:width="1.5dip" android:color="@color/neutral_white16" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/switch_checked_color" />
            <corners android:radius="99.0dip" />
        </shape>
    </item>
</selector>
